# Copy to .env (never commit .env: it is listed in .gitignore) and fill in the values.
# A variable already set in the terminal (export ...) takes precedence over this file.
# Empty values are ignored.

# Key of the local Olala server (mlx-engine): the same value as the MLX_ENGINE_API_KEY
# exported in the terminal that runs the server. Name set by "api_key_env" in config.json.
MLX_ENGINE_API_KEY=

# Optional: Légifrance via PISTE (the two Légifrance tools appear only when both are set).
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=
