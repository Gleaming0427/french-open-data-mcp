{
  "_note": "Copy to config.json. 'llm': a local OpenAI-compatible model with tool calling (default: Olala served by mlx-engine on this Mac, see the README). 'mcp_servers': MCP servers started on this machine as subprocesses (stdio). Keys are read from environment variables or from a .env file (see .env.example), never from this file.",
  "llm": {
    "base_url": "http://127.0.0.1:8000/v1",
    "api_key_env": "MLX_ENGINE_API_KEY",
    "model": "olala",
    "stream": true,
    "max_tokens": 4096,
    "params": {"temperature": 0.8, "top_p": 0.9, "top_k": 40, "chat_template_kwargs": {"reasoning_effort": "low"}}
  },
  "mcp_servers": [
    {"name": "french-open-data", "command": ["python3", "-m", "fr_open_data.server"]}
  ],
  "max_turns": 6,
  "max_tool_calls": 10,
  "max_result_chars": 8000,
  "_other_llms": {
    "ollama_local": {
      "base_url": "http://localhost:11434/v1",
      "api_key_env": null,
      "model": "qwen3",
      "stream": true,
      "params": {"temperature": 0.2}
    },
    "fake_llm_for_tests": {
      "base_url": "http://127.0.0.1:8099/v1",
      "api_key_env": null,
      "model": "fake",
      "stream": true
    }
  }
}
